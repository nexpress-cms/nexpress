{
  "name": "create-nexpress",
  "version": "0.1.41",
  "description": "Scaffolder CLI for new NexPress projects (npx create-nexpress).",
  "license": "MIT",
  "author": "Nexpress",
  "homepage": "https://github.com/nexpress-cms/nexpress#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nexpress-cms/nexpress.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/nexpress-cms/nexpress/issues"
  },
  "keywords": [
    "nexpress",
    "cli",
    "scaffolder",
    "create-nexpress"
  ],
  "type": "module",
  "bin": {
    "create-nexpress": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@nexpress/admin": "workspace:*",
    "@nexpress/auth-pages": "workspace:*",
    "@nexpress/blocks": "workspace:*",
    "@nexpress/core": "workspace:*",
    "@nexpress/next": "workspace:*",
    "@nexpress/theme": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.templates.json",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "test": "vitest run",
    "check-snapshot": "tsx scripts/check-snapshot.ts",
    "sync-snapshot": "tsx scripts/sync-snapshot.ts"
  }
}
