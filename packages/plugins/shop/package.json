{
  "name": "@nexpress/plugin-shop",
  "version": "0.4.6",
  "description": "Catalog, member wishlists, alerts, promotions, reviews, cart, checkout, order, inventory, payment, fulfillment, refund, return, and same-item exchange with packaging proposals, durable packing work and status evidence, carrier booking, label acquisition and voiding, and pickup availability for NexPress.",
  "license": "MIT",
  "author": "Nexpress",
  "homepage": "https://github.com/nexpress-cms/nexpress#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nexpress-cms/nexpress.git",
    "directory": "packages/plugins/shop"
  },
  "bugs": {
    "url": "https://github.com/nexpress-cms/nexpress/issues"
  },
  "keywords": [
    "nexpress",
    "plugin",
    "shop",
    "catalog",
    "wishlist",
    "restock-alert",
    "price-alert",
    "packaging",
    "storefront"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./restock-alert-client": {
      "types": "./dist/restock-alert-client.d.ts",
      "import": "./dist/restock-alert-client.js",
      "default": "./dist/restock-alert-client.js"
    },
    "./price-alert-client": {
      "types": "./dist/price-alert-client.d.ts",
      "import": "./dist/price-alert-client.js",
      "default": "./dist/price-alert-client.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@nexpress/core": "workspace:*",
    "@nexpress/editor": "workspace:*",
    "@nexpress/next": "workspace:*",
    "@nexpress/plugin-sdk": "workspace:*",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch --no-clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "test": "vitest run"
  }
}
